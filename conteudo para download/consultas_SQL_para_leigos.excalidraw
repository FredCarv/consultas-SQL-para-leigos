      "originalText": "seleciona apenas os valores únicos das colunas que forem escritas após o termo 'distinct'",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TieZyiA0qyFWRevOkC9f-",
      "type": "text",
      "x": 2499.9391682305372,
      "y": 969.6208149883114,
      "width": 99.79995727539062,

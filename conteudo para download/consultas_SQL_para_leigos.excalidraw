    {
      "id": "8uXDC-4JKhn7C3qHy4tnk",
      "type": "text",
      "x": 5355.664768526826,
      "y": 403.98739900843043,
      "width": 1036.179443359375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],

      "seed": 730413851,
      "version": 1784,
      "versionNonce": 1814015451,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778004876265,
      "link": null,
      "locked": false,
      "text": "No exemplo acima, o resultado final da query retornará apenas linhas em\nque os valores da coluna tipo_dados na base A são iguais a 'diarizado'",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No exemplo acima, o resultado final da query retornará apenas linhas em\nque os valores da coluna tipo_dados na base A são iguais a 'diarizado'",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "U3PGpX9pdIfZKdqb4OxzU",
      "type": "text",
      "x": 6946.796193432197,
      "y": 543.5572595945805,
      "width": 97.87995910644531,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

      "roundness": null,
      "seed": 431426619,
      "version": 4875,
      "versionNonce": 1550215515,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778010682041,
      "link": null,
      "locked": false,
      "text": "Não se limite ao exemplo usado, ele pode ser aplicado a dados de diferentes tipos, aplicar diferentes operações e condições, o limite é ditado pelo contexto.\nA base é:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Não se limite ao exemplo usado, ele pode ser aplicado a dados de diferentes tipos, aplicar diferentes operações e condições, o limite é ditado pelo contexto.\nA base é:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "OtmHG1hhzcwXaQMnsfRR8",
      "type": "text",
      "x": 2488.27146030933,
      "y": 2255.876349751503,
      "width": 1285.979248046875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "axuzV",
      "roundness": null,
      "seed": 537003125,
      "version": 5208,
      "versionNonce": 1624874261,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778010859917,
      "link": null,
      "locked": false,
      "text": "WHEN qualquer coisa que você conseguir aplicar a uma coluna THEN valor que você deseja atribuir ao resultado dessa qualquer coisa\nELSE valor atribuído a todas as exceções que passaram pelos WHENs escritos\nEND AS cabeçallho da coluna",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHEN qualquer coisa que você conseguir aplicar a uma coluna THEN valor que você deseja atribuir ao resultado dessa qualquer coisa\nELSE valor atribuído a todas as exceções que passaram pelos WHENs escritos\nEND AS cabeçallho da coluna",
      "autoResize": true,
      "lineHeight": 1.25
    },

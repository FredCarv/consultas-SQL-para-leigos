    {
      "id": "1TRYyCMj0DVONmv6gVcPC",
      "type": "text",
      "x": 2489.3321610294397,
      "y": 2175.263095023164,
      "width": 1525.4189453125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

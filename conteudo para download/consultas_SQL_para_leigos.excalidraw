      "seed": 127843579,
      "version": 1825,
      "versionNonce": 1170867995,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778004883345,
      "link": null,
      "locked": false,
      "text": "ATENÇÃO",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ATENÇÃO",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cb_fEXFSHBK-QtUILJlLD",
      "type": "text",
      "x": 7057.290318827862,
      "y": 541.5572595945805,
      "width": 646.8994750976562,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2jYl",
      "roundness": null,
      "seed": 397451259,
      "version": 2326,
      "versionNonce": 21281429,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778005105803,
      "link": null,
      "locked": false,
      "text": "para o tipo de dado. No caso usado como exemplo, 'diarizado'\nestá entre aspas porque a coluna tipo_dados é uma coluna\nde dados tipo STRING, se fosse uma coluna FLOAT, por exemplo,\nnão seria necessário usar as aspas, mas aí o valor do filtro\nprecisaria ser um número.\nA mesma linha de raciocínio deve ser considerada caso você aplique\nalguma operação na(s) coluna(s) do WHERE",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "para o tipo de dado. No caso usado como exemplo, 'diarizado'\nestá entre aspas porque a coluna tipo_dados é uma coluna\nde dados tipo STRING, se fosse uma coluna FLOAT, por exemplo,\nnão seria necessário usar as aspas, mas aí o valor do filtro\nprecisaria ser um número.\nA mesma linha de raciocínio deve ser considerada caso você aplique\nalguma operação na(s) coluna(s) do WHERE",
      "autoResize": true,
      "lineHeight": 1.25
    },

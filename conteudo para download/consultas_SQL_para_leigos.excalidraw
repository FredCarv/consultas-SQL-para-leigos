      "index": "a2jY",
      "roundness": null,
      "seed": 923364053,
      "version": 1596,
      "versionNonce": 420468757,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778004775649,
      "link": null,
      "locked": false,
      "text": "Nele se aplica a mesma lógica de AND e OR, podendo adicionar quantas\ncondições quiser, assim como no JOIN.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nele se aplica a mesma lógica de AND e OR, podendo adicionar quantas\ncondições quiser, assim como no JOIN.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rpQznDNWuXtHCANzNfFOS",
      "type": "text",
      "x": 6946.796193432197,
      "y": 453.97985845974085,
      "width": 696.4395141601562,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
